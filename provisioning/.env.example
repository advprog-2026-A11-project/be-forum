# AWS credentials/profile
AWS_REGION=ap-southeast-1
# Option A: use AWS shared profile
# AWS_PROFILE=default
# Option B: put direct credentials here (common for AWS Academy)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...

# EC2 sizing and storage
# Option A (recommended): set explicit instance type
INSTANCE_TYPE=t3.medium
# Option B: leave INSTANCE_TYPE empty and set RAM requirement in GiB
# MIN_RAM_GIB=4

ROOT_VOLUME_GB=30

# Networking
VPC_ID=
SUBNET_ID=
# Security group name to create or reuse in VPC
SECURITY_GROUP_NAME=be-forum-sg

# Comma-separated list of ingress ports (TCP) to open to INTERNET (0.0.0.0/0)
# Example: 22,80,443,3000,8080
OPEN_PORTS=22,80,443

# SSH key pair for EC2
# If KEY_PAIR_NAME exists in region, it will be reused.
# If not exists and CREATE_KEY_PAIR=true, script creates and saves private key.
KEY_PAIR_NAME=be-forum-key
CREATE_KEY_PAIR=true
KEY_OUTPUT_PATH=./provisioning/keys

# Optional tags
INSTANCE_NAME=be-forum-ec2
PROJECT_TAG=be-forum
ENV_TAG=dev

# Elastic IP association (optional)
# Set one of these if you already have an Elastic IP:
# EIP_ALLOCATION_ID=eipalloc-xxxxxxxxxxxxxxxxx
# EIP_PUBLIC_IP=1.2.3.4

# Optional: reuse existing SG instead of creating one
# SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx

# Optional: custom AMI (if not set, Ubuntu 24.04 LTS AMI is auto-discovered via SSM)
# AMI_ID=ami-xxxxxxxxxxxxxxxxx

# Enable dry run
DRY_RUN=false

# -------- Destroy flow (destroy_ec2.py) --------
# Optional explicit target instance ID (recommended for safety)
# DESTROY_INSTANCE_ID=i-0123456789abcdef0

# Skip interactive confirmation if true
DESTROY_FORCE=false

# Optional cleanup behavior
RELEASE_EIP_ON_DESTROY=false
DELETE_KEY_PAIR_ON_DESTROY=false
DELETE_LOCAL_KEY_FILE_ON_DESTROY=false

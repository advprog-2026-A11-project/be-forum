# AWS auth (choose your preferred method)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...
# AWS_PROFILE=default

# Terraform variables (TF_VAR_*)
TF_VAR_aws_region=aus-east-1
TF_VAR_aws_profile=

TF_VAR_instance_name=be-forum-ec2
TF_VAR_project_tag=be-forum
TF_VAR_env_tag=dev

# VM config
TF_VAR_instance_type=t3.micro
TF_VAR_ami_id=ami-xxxxxxxxxxxxxxxxx
TF_VAR_root_volume_gb=30
TF_VAR_key_pair_name=be-forum-key

# Network (leave empty to use defaults)
TF_VAR_vpc_id=
TF_VAR_subnet_id=

# Security group
# If existing SG is set, Terraform will attach to it and skip SG creation.
TF_VAR_existing_security_group_id=
TF_VAR_security_group_name=be-forum-sg
TF_VAR_open_ports_csv=22,80,443

# Elastic IP
# true = always attach an EIP to the VM
TF_VAR_assign_eip=true
# Leave empty to create a new EIP, or set an existing allocation id.
TF_VAR_existing_eip_allocation_id=
